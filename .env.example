# Copiar a .env y completar. Nunca subir .env al repositorio.

# Conexión a PostgreSQL (ver docker-compose.yml para el entorno de desarrollo)
DATABASE_URL="postgresql://rrhh:rrhh@localhost:5432/rrhh?schema=public"

# Base de datos usada por los tests de integración (se vacía en cada corrida)
TEST_DATABASE_URL="postgresql://rrhh:rrhh@localhost:5432/rrhh_test?schema=public"

# URL pública de la aplicación (se usa para verificar el origen de las peticiones)
APP_URL="http://localhost:3000"

# Carpeta donde se guardan los archivos adjuntos (debe ser persistente en producción)
STORAGE_DIR="./storage"

# Nivel de logs: fatal | error | warn | info | debug | trace
LOG_LEVEL="info"

# Usuario administrador que crea el seed
SEED_ADMIN_EMAIL="admin@empresa-demo.com.ar"
SEED_ADMIN_PASSWORD="cambiar-esta-clave"
