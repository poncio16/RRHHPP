# Producción con Docker Compose. Copiar a .env en la carpeta del proyecto en el
# servidor, completar y dejarlo con permisos 600 (chmod 600 .env).
# Nunca subir .env al repositorio. Ver docs/operacion.md.

# Usa el compose de producción aunque se escriba solo `docker compose ...`.
COMPOSE_FILE=docker-compose.prod.yml

# Contraseña del superusuario de PostgreSQL (solo para backups y mantenimiento).
# Generala con: openssl rand -hex 24
POSTGRES_PASSWORD=

# Usuario y base de la aplicación (el usuario no es superusuario).
APP_DB_NAME=rrhh
APP_DB_USER=rrhh
# Va dentro de una URL: usá solo letras y números. Generala con: openssl rand -hex 24
APP_DB_PASSWORD=

# Dirección pública, con HTTPS (la cookie de sesión exige HTTPS en producción).
APP_URL=https://rrhh.ejemplo.com.ar

# "true": la app está detrás del proxy inverso del servidor (nginx), que informa la IP real.
TRUSTED_PROXY=true

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=info

# Puerto local donde escucha la app (solo 127.0.0.1; el proxy inverso le pasa los pedidos).
APP_PORT=3000

# Etiqueta de las imágenes que se construyen. Cambiarla en cada actualización
# permite volver a la imagen anterior si hace falta.
APP_VERSION=latest

# Backups (scripts/backup.sh): carpeta de destino y días que se conservan.
BACKUP_DIR=./backups
BACKUP_RETENTION_DAYS=30
